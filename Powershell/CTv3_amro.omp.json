{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#073642",
          "foreground": "#45F1C2",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "template": "\ueb99 {{ .UserName }} <transparent,#073642>\ue0d7</>",
          "type": "session"
        },
        {
          "background": "#2AA198",
          "foreground": "#073642",
          "options": {
            "time_format": "Mon 2 Jan"
          },
          "style": "diamond",
          "template": "<transparent,#2AA198>\ue0b0</> \uf073 {{ .CurrentDate | date .Format }} <transparent,#2AA198>\ue0d7</>",
          "type": "time"
        },
        {
          "background": "#073642",
          "foreground": "#2AA198",
          "foreground_templates": [
            "{{ if and (.Working.Changed) (.Staging.Changed) }}#cb4b16{{ end }}",
            "{{ if (.Working.Changed) }}#dc322f{{ end }}",
            "{{ if (.Staging.Changed) }}#b58900{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#cb4b16{{ end }}",
            "{{ if gt .Ahead 0 }}#859900{{ end }}",
            "{{ if gt .Behind 0 }}#d33682{{ end }}"
          ],
          "options": {
            "fetch_upstream_icon": true,
            "fetch_status": true
          },
          "style": "diamond",
          "trailing_diamond": "\ue0b0",
          "template": "<transparent,#073642>\ue0b0</> {{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf0c7 {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#073642",
          "foreground": "#2AA198",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "template": " \uf489 {{ .Name }} <transparent,#073642>\ue0b2</>",
          "type": "shell"
        },
        {
          "background": "#2AA198",
          "foreground": "#002b36",
          "style": "plain",
          "options": {
            "always_enabled": true
          },
          "template": "<#2AA198,transparent>\ue0b2</> \ueba2 {{ .FormattedMs }}\u2800<transparent,#2AA198>\ue0b2</>",
          "type": "executiontime"
        },
        {
          "type": "time",
          "style": "diamond",
          "foreground": "#2AA198",
          "background": "#073642",
          "trailing_diamond": "\ue0b4",
          "template": "<#073642,transparent>\ue0b2</> {{ .CurrentDate | date \"15:04\" }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#268bd2",
          "options": {
            "folder_separator_icon": "/",
            "style": "full"
          },
          "style": "plain",
          "template": "\uf07b {{ .Path }} ",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#dc322f",
          "style": "plain",
          "template": "\ue3bf ",
          "type": "root"
        },
        {
          "foreground": "#D33682",
          "style": "plain",
          "template": "> ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}
